[Unit]
Description=Wii Balance Board to Home Assistant bridge
Documentation=https://github.com/larsabrasha/body-stats
After=network-online.target bluetooth.service
Wants=network-online.target

[Service]
Type=simple
User=wiiscale
Group=wiiscale
# Reading /dev/input/event* needs the input group; nothing else here does.
SupplementaryGroups=input
EnvironmentFile=-/etc/wiiscale/wiiscale.env
ExecStart=/opt/wiiscale/venv/bin/wiiscale --config /etc/wiiscale/config.yaml run
Restart=always
RestartSec=5
# Nothing here grows without bound - the measurement window is pruned and the
# auto-tare buffer is capped - so this is a backstop, not a workaround. If the
# bridge ever does leak, systemd kills it and Restart=always brings it back,
# which beats a nightly restart that runs whether it is needed or not.
MemoryMax=150M

# The bridge reads one device node and talks to one broker; it has no business
# writing anywhere on this machine.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_BLUETOOTH is for the l2cap backend, which opens the board's HID channels
# itself. Without it that backend fails under systemd while working fine by
# hand, which is a miserable thing to debug.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_BLUETOOTH
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
